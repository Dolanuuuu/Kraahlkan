# ============================================================
# KRAAHL WORKSPACE - KAN Configuration
# ============================================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# ----- REQUIRED -----
# URL publique de l'instance (ex: https://kan.kraahl.com ou http://10.8.0.1:3000)
NEXT_PUBLIC_BASE_URL=https://kan.kraahl.com

# Clé secrète auth (32+ caractères) - NE PAS PARTAGER
BETTER_AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# ----- BASE DE DONNÉES -----
# PostgreSQL password (pour le container interne)
POSTGRES_PASSWORD=kraahl_pg_secure_password

# URL de connexion (générée auto depuis les vars ci-dessus si vide)
POSTGRES_URL=postgresql://kraahl:kraahl_pg_secure_password@kraahl-db:5432/kraahl_db

# ----- PORT WEB -----
WEB_PORT=3000

# ----- AUTH OPTIONS -----
NEXT_PUBLIC_ALLOW_CREDENTIALS=true
# Mettre à true pour bloquer les inscriptions publiques (accès VPN uniquement)
NEXT_PUBLIC_DISABLE_SIGN_UP=false

# ----- SMTP / EMAIL (optionnel) -----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Kraahl Kan <no-reply@kraahl.com>
SMTP_SECURE=true
SMTP_REJECT_UNAUTHORIZED=true
# Désactiver les emails si pas de SMTP configuré
NEXT_PUBLIC_DISABLE_EMAIL=true

# ----- STOCKAGE S3 (optionnel - pour avatars et pièces jointes) -----
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
NEXT_PUBLIC_STORAGE_URL=
NEXT_PUBLIC_AVATAR_BUCKET_NAME=kraahl-avatars
NEXT_PUBLIC_ATTACHMENTS_BUCKET_NAME=kraahl-attachments
NEXT_PUBLIC_STORAGE_DOMAIN=
NEXT_PUBLIC_USE_VIRTUAL_HOSTED_URLS=

# ----- REDIS (optionnel - rate limiting) -----
REDIS_URL=

# ----- OAUTH PROVIDERS (optionnel) -----
BETTER_AUTH_TRUSTED_ORIGINS=https://kan.kraahl.com
# Restreindre aux emails @kraahl.com uniquement (optionnel)
# BETTER_AUTH_ALLOWED_DOMAINS=kraahl.com

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ----- LOGGING -----
LOG_LEVEL=info

# ----- OPENVPN NETWORK -----
# Si l'accès est restreint au réseau VPN, renseigner les IPs autorisées dans nginx.conf
# Plage IP OpenVPN typique: 10.8.0.0/24
